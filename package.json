{
  "name": "vulnex",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "api",
    "tests",
    "src",
    "data-sync"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "start": "node index.js",
    "start:api": "npm run start -w=api",
    "dev:api": "dotenvx run -- npm run dev -w=api",
    "test:api": "dotenvx run -- npm run test:api -w tests",
    "test:api:action": "npm run test:api -w tests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "data-sync": "dotenvx run -- npm run dev -w data-sync",
    "db:delete": " dotenvx run -- npm run delete -w data-sync",
    "fetch": "dotenvx run -- npm run fetch -w data-sync"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.30.0",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^18.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.1.7"
  }
}
